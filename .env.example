# ═══════════════════════════════════════════════════════════════════════════════
# CARDSTACK CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and customize for your instance.
# All values shown are defaults - only set what you want to change.
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# SITE IDENTITY
# ───────────────────────────────────────────────────────────────────────────────
# The name of your kanban board (appears in header, browser title, etc.)
SITE_NAME="CardStack"

# A short tagline for your site (currently unused, reserved for future)
SITE_TAGLINE="A flat-file kanban board"

# Emoji displayed next to site name when no logo is set
SITE_EMOJI="📋"

# The base URL of your site (optional, used for generating absolute URLs)
# Example: https://boards.example.com
SITE_URL=""

# ───────────────────────────────────────────────────────────────────────────────
# BRANDING - IMAGES
# ───────────────────────────────────────────────────────────────────────────────
# Path to your logo image. If set, replaces emoji + site name in header.
# Recommended: PNG or SVG, height ~24-32px
# Example: /assets/my-logo.png
LOGO_URL=""

# Width constraint for logo (CSS value)
LOGO_WIDTH="120"

# Path to favicon image (PNG recommended, 32x32 or larger)
# If not set, the site emoji will be used as the favicon
# Example: /assets/favicon.png
FAVICON_URL=""

# Use a specific emoji as favicon (overrides SITE_EMOJI for favicon only)
FAVICON_EMOJI=""

# Custom letter to overlay on favicon (default: first letter of SITE_NAME)
# Set to a single character to customize, or leave empty for default
FAVICON_LETTER=""

# Show letter overlay on favicon (set to false to disable)
FAVICON_SHOW_LETTER=true

# ───────────────────────────────────────────────────────────────────────────────
# BRANDING - EXTERNAL LINK
# ───────────────────────────────────────────────────────────────────────────────
# Optional link shown in the header (e.g., link to your main website)
# Leave empty to hide the external link entirely
EXTERNAL_LINK_NAME=""
EXTERNAL_LINK_URL=""
EXTERNAL_LINK_LOGO=""

# ───────────────────────────────────────────────────────────────────────────────
# BRANDING - FOOTER
# ───────────────────────────────────────────────────────────────────────────────
# Footer text (supports basic HTML)
# Example: "&copy; 2025 My Company. All rights reserved."
FOOTER_TEXT=""

# Show "Powered by CardStack" link in footer
FOOTER_SHOW_POWERED_BY=true

# ───────────────────────────────────────────────────────────────────────────────
# BRANDING - COLORS
# ───────────────────────────────────────────────────────────────────────────────
# Primary brand color (used for links, buttons, active states)
# Default is a pleasant blue
COLOR_PRIMARY="#3b82f6"

# Primary color hover state
COLOR_PRIMARY_HOVER="#2563eb"

# For more extensive color customization, use custom.css

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY - AUTHENTICATION
# ───────────────────────────────────────────────────────────────────────────────
# Super admin credentials (automatically created on first access)
# The super admin can manage all other users and cannot be deleted.
#
# To generate a password hash, run:
#   php -r "echo password_hash('your-password-here', PASSWORD_DEFAULT);"
#
# Example hash for password "admin123" (DO NOT USE IN PRODUCTION):
# SUPER_ADMIN_PASSWORD_HASH="$2y$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD_HASH=""

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY - SESSION & RATE LIMITING
# ───────────────────────────────────────────────────────────────────────────────
# These values are currently hardcoded but documented here for reference
# Future versions may make these configurable

# Session lifetime in seconds (default: 7200 = 2 hours)
# SESSION_LIFETIME=7200

# Maximum failed login attempts before lockout (default: 5)
# MAX_LOGIN_ATTEMPTS=5

# Lockout duration in seconds after max attempts (default: 900 = 15 minutes)
# LOCKOUT_DURATION=900

# ───────────────────────────────────────────────────────────────────────────────
# STORAGE
# ───────────────────────────────────────────────────────────────────────────────
# Path to data storage directory (relative to project root or absolute)
# Default: ./data
DATA_PATH="./data"

# ───────────────────────────────────────────────────────────────────────────────
# VISIBILITY
# ───────────────────────────────────────────────────────────────────────────────
# Workspace visibility controls who can access boards without logging in.
#
# Options:
#   - "private" (default): Login required to view any boards
#   - "public": Boards can be viewed without login (individual boards can
#               still be restricted via their visibility settings)
#
# When WORKSPACE_VISIBILITY is "public", individual boards can be set to:
#   - "inherit" (default): Follow workspace visibility (public)
#   - "public": Always publicly accessible
#   - "restricted": Only accessible to logged-in users with explicit access
WORKSPACE_VISIBILITY="private"

# ───────────────────────────────────────────────────────────────────────────────
# FEATURES
# ───────────────────────────────────────────────────────────────────────────────
# Enable dark mode support (auto-detects system preference)
FEATURE_DARK_MODE=true

# Enable keyboard shortcuts
# FEATURE_KEYBOARD_SHORTCUTS=true

# Enable drag and drop for cards and columns
# FEATURE_DRAG_DROP=true

# ───────────────────────────────────────────────────────────────────────────────
# ADVANCED
# ───────────────────────────────────────────────────────────────────────────────
# Enable debug mode (shows detailed errors - NEVER use in production)
# DEBUG=false

# Timezone for date/time operations
# Example: America/New_York, Europe/London, Asia/Tokyo
# TIMEZONE="UTC"
